{
  "manifest_version": 3,
  "name": "Rolimons Trading Value Overlay",
  "version": "1.0.0",
  "description": "Shows, Rolimon's item values directly on Roblox trade pages, with customizable background and text colors.",
  "icons": {
    "48": "icon.png",
    "96": "icon2.png"
  },
  "host_permissions": [
    "https://www.roblox.com/*",
    "https://api.rolimons.com/*"
  ],
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/trades*",
        "https://www.roblox.com/users/*/trade*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "rolimons-set-value-overlay1@example.com",
      "data_collection_permissions": {
        "required": [
          "websiteActivity"
        ]
      }
    }
  }
}
